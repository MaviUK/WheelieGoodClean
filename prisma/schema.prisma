generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String?
  accessToken  String?
  refreshToken String?
  scope        String?
  tokenType    String?
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
